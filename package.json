{
  "name": "muhammed-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --open /",
    "serve:legacy": "node scripts/serve-static.mjs 4310",
    "build": "vite build",
    "build:reference": "vite build --mode reference",
    "build:preview": "vite build -c vite.preview.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:preview && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:reference && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.10.2",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
