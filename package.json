{
  "name": "muhammed-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --open /dev/",
    "serve:legacy": "node scripts/serve-static.mjs 4310",
    "build:reference": "vite build",
    "build:preview": "vite build -c vite.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build:preview && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:reference && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.10.2",
    "@types/pngjs": "6.0.5",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
