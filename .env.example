# Contact form delivery (src/features/contact/send.ts). Copy to .env.local and fill in.
# 'mailto' (default) opens the visitor's email app; 'service' posts to a form service.
VITE_CONTACT_MODE=mailto
# The form service endpoint, e.g. https://formspree.io/f/xxxxxxx (used when the mode is 'service').
VITE_FORM_ENDPOINT=
